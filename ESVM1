class HomeScreen extends ConsumerWidget {
  const HomeScreen({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    // FutureProvider として ESVMビューを監視
    final esvmViewAsync = ref.watch(esvmSimpleViewProvider);

    return Scaffold(
      appBar: AppBar(
        title: const Text(
          'Zureon Ω',
          style: TextStyle(fontWeight: FontWeight.bold),
        ),
        centerTitle: true,
        backgroundColor: Colors.transparent,
        elevation: 0,
      ),
      body: esvmViewAsync.when(
        // ローディング時
        loading: () => const Center(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              CircularProgressIndicator(),
              SizedBox(height: 16),
              Text('負荷を計算中...', style: TextStyle(fontSize: 16)),
            ],
          ),
        ),
        // エラー時
        error: (err, stack) => Center(
          child: Padding(
            padding: const EdgeInsets.all(32.0),
            child: Text(
              '計算エラーが発生しました:\n$err',
              textAlign: TextAlign.center,
              style: const TextStyle(color: Colors.red),
            ),
          ),
        ),
        // 正常時
        data: (view) {
          // Mapの中身を一旦ローカル変数に展開（?[] が使えないため）
          final stressMap =
              view['stress'] as Map<String, dynamic>? ?? <String, dynamic>{};
          final inconsistencyMap =
              view['inconsistency'] as Map<String, dynamic>? ??
                  <String, dynamic>{};
          final futureMap =
              view['future'] as Map<String, dynamic>? ?? <String, dynamic>{};
          final stateMap =
              view['state'] as Map<String, dynamic>? ?? <String, dynamic>{};

          final int stressScore = (stressMap['score'] ?? 0) as int;
          final int inconsistencyScore =
              (inconsistencyMap['score'] ?? 0) as int;
          final int futureScore = (futureMap['score'] ?? 0) as int;
          final int stateRaw = (stateMap['raw'] ?? 0) as int;

          final String stressLabel = (stressMap['label'] ?? '') as String;
          final String inconsistencyLabel =
              (inconsistencyMap['label'] ?? '') as String;
          final String futureLabel = (futureMap['label'] ?? '') as String;
          final String stateLabel =
              (stateMap['label'] ?? '読み込み中...') as String;

          final String stressColorHex =
              (stressMap['color'] ?? '#FFD600') as String;
          final String inconsistencyColorHex =
              (inconsistencyMap['color'] ?? '#FFD600') as String;
          final String futureColorHex =
              (futureMap['color'] ?? '#FFD600') as String;

          final stressColor = Color(
            int.parse(stressColorHex.replaceFirst('#', '0xFF')),
          );
          final inconsistencyColor = Color(
            int.parse(inconsistencyColorHex.replaceFirst('#', '0xFF')),
          );
          final futureColor = Color(
            int.parse(futureColorHex.replaceFirst('#', '0xFF')),
          );

          return SingleChildScrollView(
            padding: const EdgeInsets.all(20),
            child: Column(
              children: [
                // 大きな円形ゲージ
                StressGauge(score: stressScore),

                const SizedBox(height: 30),

                // 全体状態テキスト
                Text(
                  stateLabel,
                  style: const TextStyle(
                    fontSize: 28,
                    fontWeight: FontWeight.bold,
                  ),
                ),

                const SizedBox(height: 40),

                // 4つのカード
                GridView.count(
                  shrinkWrap: true,
                  physics: const NeverScrollableScrollPhysics(),
                  crossAxisCount: 2,
                  crossAxisSpacing: 16,
                  mainAxisSpacing: 16,
                  childAspectRatio: 1.6,
                  children: [
                    StatusCard(
                      title: "今のしんどさ",
                      score: stressScore,
                      label: stressLabel,
                      color: stressColor,
                    ),
                    StatusCard(
                      title: "心と体のズレ",
                      score: inconsistencyScore,
                      label: inconsistencyLabel,
                      color: inconsistencyColor,
                    ),
                    StatusCard(
                      title: "30秒後の予測",
                      score: futureScore,
                      label: futureLabel,
                      color: futureColor,
                    ),
                    StatusCard(
                      title: "全体状態",
                      // raw を 0〜4 → 0〜40 にして「なんとなく数値」感だけ出す
                      score: stateRaw * 10,
                      label: stateLabel,
                      color: Colors.deepPurple,
