import 'package:flutter/material.dart';
import 'dart:math' as math;

class StressGauge extends StatelessWidget {
  final int score; // 0-100

  const StressGauge({super.key, required this.score});

  @override
  Widget build(BuildContext context) {
    // clamp は num を返すので toDouble() してから割る
    final double value = score.clamp(0, 100).toDouble() / 100.0;

    Color gaugeColor;
    if (value < 0.25) {
      gaugeColor = const Color(0xFF00C853); // かなり余裕
    } else if (value < 0.5) {
      gaugeColor = const Color(0xFFFFD600); // ふつう
    } else if (value < 0.75) {
      gaugeColor = const Color(0xFFFF9100); // ちょっとしんどい
    } else {
      gaugeColor = const Color(0xFFD50000); // かなりしんどい
    }

    return SizedBox(
      width: 220,
      height: 220,
      child: Stack(
        alignment: Alignment.center,
        children: [
          SizedBox(
            width: 200,
            height: 200,
            child: CircularProgressIndicator(
              value: value,
              strokeWidth: 16,
              backgroundColor: Colors.grey[300],
              valueColor: AlwaysStoppedAnimation(gaugeColor),
            ),
          ),
          // 目盛り
          Transform.rotate(
            angle: -math.pi / 2,
            child: CustomPaint(
              size: const Size(200, 200),
              painter: _GaugeTickPainter(),
            ),
          ),
          // 中央の数値表示
          Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              Text(
                '$score',
                style: const TextStyle(
                  fontSize: 48,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const Text(
                'しんどさ',
                style: TextStyle(fontSize: 16),
              ),
            ],
          ),
        ],
      ),
    );
  }
}

class _GaugeTickPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final center = Offset(size.width / 2, size.height / 2);
    const radius = 90.0;

    final paint = Paint()
      ..color = Colors.grey[400]!
      ..strokeWidth = 2;

    for (int i = 0; i < 40; i++) {
      final angle = i * 9 * math.pi / 180; // 40 * 9° = 360°
      final bool isLong = i % 5 == 0;
      final double innerR = radius - (isLong ? 15.0 : 8.0);
      const double outerR = radius;

      final start = Offset(
        center.dx + innerR * math.cos(angle),
        center.dy + innerR * math.sin(angle),
      );
      final end = Offset(
        center.dx + outerR * math.cos(angle),
        center.dy + outerR * math.sin(angle),
      );
      canvas.drawLine(start, end, paint);
    }
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}


