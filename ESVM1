/// ダミーデータを生成する関数
Map<String, Map<String, dynamic>> _createDummyView(double subjective) {
  final rng = Random();

  // 主観に少しノイズを足して“リアルっぽく”
  final baseStress = subjective + rng.nextDouble() * 20 - 10;
  final stress = baseStress.clamp(0.0, 100.0);

  final inconsistency =
      (rng.nextDouble() * 40 + (subjective - stress).abs() * 0.5)
          .clamp(0.0, 100.0);

  final future = (stress + rng.nextDouble() * 30).clamp(0.0, 100.0);

  // しんどさラベル & 色
  late String stressLabel;
  late String stressColor;
  if (stress < 25) {
    stressLabel = "かなり余裕";
    stressColor = "#00C853";
  } else if (stress < 50) {
    stressLabel = "ふつう";
    stressColor = "#FFD600";
  } else if (stress < 75) {
    stressLabel = "ちょっとしんどい";
    stressColor = "#FF9100";
  } else {
    stressLabel = "かなりしんどい";
    stressColor = "#D50000";
  }

  // ズレラベル & 色
  final inconsNorm = inconsistency / 100.0;
  late String inconsLabel;
  late String inconsColor;
  if (inconsNorm < 0.25) {
    inconsLabel = "自覚と身体はだいたい一致";
    inconsColor = "#00C853";
  } else if (inconsNorm < 0.5) {
    inconsLabel = "ちょっとズレてる";
    inconsColor = "#FFD600";
  } else if (inconsNorm < 0.75) {
    inconsLabel = "けっこうズレてる";
    inconsColor = "#FF9100";
  } else {
    inconsLabel = "かなりズレが大きい";
    inconsColor = "#D50000";
  }

  // 未来予測ラベル & 色
  late String futureLabel;
  late String futureColor;
  if (future < 30) {
    futureLabel = "このままでも大丈夫そう";
    futureColor = "#00C853";
  } else if (future < 70) {
    futureLabel = "このペースが続くと重くなりそう";
    futureColor = "#FFD600";
  } else {
    futureLabel = "このままはキツいかも";
    futureColor = "#D50000";
  }

  // 全体状態
  final stateIdx =
      ((stress / 25.0).floor()).clamp(0, 4).toInt(); // 0〜4 にクリップ
  const stateLabels = [
    "かなり余裕",
    "ふつう",
    "じわ疲れ",
    "しんどいゾーン",
    "限界手前",
  ];

  return {
    "state": {
      "raw": stateIdx,
      "label": stateLabels[stateIdx],
    },
    "stress": {
      "score": stress.round(),
      "color": stressColor,
      "label": stressLabel,
    },
    "inconsistency": {
      "score": inconsistency.round(),
      "color": inconsColor,
      "label": inconsLabel,
    },
    "future": {
      "score": future.round(),
      "color": futureColor,
      "label": futureLabel,
    },
  };
}

/// ESVM “処理器”
/// - 1秒ごとに FutureProvider を再実行して「ちょっと揺れる」感じを出す
final esvmProcessorProvider =
    StateNotifierProvider<ProcessorNotifier, int>((ref) {
  return ProcessorNotifier(ref);
});

class ProcessorNotifier extends StateNotifier<int> {
  ProcessorNotifier(this.ref) : super(0) {
    _startTimer();
  }

  final Ref ref;

  void _startTimer() async {
    while (ref.mounted) {
      await Future.delayed(const Duration(seconds: 1));
      // 状態を少しだけ更新（UIでは使わなくてOK）
      state++;
      ref.invalidate(esvmSimpleViewProvider);
    }
  }

  /// 主観値の更新（スライダーから呼ばれる）
  void updateSubjective(double value) {
    ref.read(subjectiveProvider.notifier).state = value;
    state++; // 変更トリガーとして増やしておく
    ref.invalidate(esvmSimpleViewProvider);
  }
}


